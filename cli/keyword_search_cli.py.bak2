import argparse
import json
import string
from nltk.stem import PorterStemmer

MOVIES_PATH = "data/movies.json"  # relative to where you run the script from
MAX_RESULTS = 5
# Translation table that deletes every ASCII punctuation character
    # "string.punctuation" is mapped to None so translate() will remove it
    # "string.punctuation" contains all ASCII punctuation characters
PUNCT_TABLE = str.maketrans("", "", string.punctuation)
STOPWORDS_PATH = "data/stopwords.txt"
STEMMER = PorterStemmer() # create once; reused for every token

def normalize(text: str) -> str:
    """Lowercase and strip punctuation so matching ignores both."""
    return text.lower().translate(PUNCT_TABLE)

def tokenize(text: str, stop_words: list[str]) -> list[str]:
    """Normalize, split on whitespace, drop stop words, then stem each token."""
    # normalize splits on whitespace:
    tokens = [tok for tok in normalize(text).split() if tok not in stop_words]
    # Stem after stop word removal: "running" -> "run", "movies" -> "movi"
    return [STEMMER.stem(tok) for tok in tokens]    

def has_matching_token(query_tokens: list[str], title_tokens: list[str]) -> bool:
    """True if at least one query token is a substring of any title token."""
    # The any() function stops executing the moment it finds the very first True match:
    return any(
        q_tok in t_tok
        for q_tok in query_tokens
        for t_tok in title_tokens
    )

def load_stop_words() -> list[str]:
    """Read stop words (one per line) and preprocess them like query/title text."""
    with open(STOPWORDS_PATH, encoding="utf-8") as f:
        lines = f.read().splitlines()
    # normalize() turns "aren't" into "arent" so it matches our tokens;
    # the `if` skips blank lines
    return [normalize(line) for line in lines if line.strip()]

def search_movies(query: str) -> list[dict]:
    """Return up to MAX_RESULTS movies with a title token containing a query token."""
    with open(MOVIES_PATH, encoding="utf-8") as f:
        data = json.load(f)

    stop_words = load_stop_words()  # loaded once, reused for every tokenize call
    query_tokens = tokenize(query, stop_words)

    results = []
    for movie in data["movies"]:
        title_tokens = tokenize(movie["title"], stop_words)
        if has_matching_token(query_tokens, title_tokens):
            results.append(movie)
            # Dataset is already sorted by ascending ID, so stop early
            if len(results) == MAX_RESULTS:
                break
    return results


def main() -> None:
    parser = argparse.ArgumentParser(description="Keyword Search CLI")
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    search_parser = subparsers.add_parser("search", help="Search movies using keywords")
    search_parser.add_argument("query", type=str, help="Search query")

    args = parser.parse_args()

    match args.command:
        case "search":
            print(f"Searching for: {args.query}")
            for i, movie in enumerate(search_movies(args.query), start=1):
                print(f"{i}. {movie['title']}")
        case _:
            parser.print_help()


if __name__ == "__main__":
    main()