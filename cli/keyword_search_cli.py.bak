# Library to parse command-line arguments:
import argparse
import json
import string

# Entry point for the Keyword Search CLI application:
def main() -> None:
    # Create the argument parser for the CLI application:
    parser = argparse.ArgumentParser(description="Keyword Search CLI")
    # Save the name of the sub-command the user types into a variable called "command":
    # Add a helpful text description to the automated help menu:
    subparsers = parser.add_subparsers(dest="command", help="Available commands")
    # Define the "search" subcommand and its arguments:
    # Set up the help documentation for this specific command:
    search_parser = subparsers.add_parser("search", help="Search movies using keywords")
    # Define what the parser should expect for this subcommand:
    # The "query" argument represents the search keyword(s):
    search_parser.add_argument("query", type=str, help="Search query")
    # Process all the inputs the user typed into the terminal and save the 
    # successfully processed inputs into an object called args:
    args = parser.parse_args()

    # Handle the subcommands based on the parsed arguments:
    match args.command:
        # Handle the "search" subcommand:
        case "search":
            print(f"Searching for: {args.query}")
            # Load the movies file into a Python dictionary:
            with open("data/movies.json", "r", encoding="utf-8") as file:
                data = json.load(file)

            results = []
            # look for a key named "movies" inside the data dictionary 
            # and return its value, defaulting to an empty list if not found:
            for movie in data.get("movies", []):
                # Create a translation table that maps all punctuation characters to None
                punctuation_table = str.maketrans("", "", string.punctuation)
                movie = movie.translate(punctuation_table)
                args.query = args.query.translate(punctuation_table)
                # Get the title of the current movie, defaulting to an empty string if not found:
                if args.query.lower() in movie.get("title", "").lower():
                    # If the search query is found in the movie title, add it to the results list:
                    results.append(movie)
            # Truncate the list to a maximum of 5 results
            truncated_results = results[:5]

            # Print the search query before displaying the results:
            print(f"Searching for: {args.query}")
            # Iterate over the truncated results starting from index 1:
            for index, movie in enumerate(truncated_results, start=1):
                # Print each truncated result with its index and title:
                print(f"{index}. {movie.get('title')}")
        # Handle unknown subcommands:
        case _:
            # Print an error message for unknown subcommands:
            parser.print_help()

# Ensure that the main() function is called when the script is 
# executed directly:
# If the script is imported as a module, the main() function will 
# not be executed automatically.
if __name__ == "__main__":
    main()
